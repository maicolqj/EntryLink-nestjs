<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}}</title>
  <style>
    body { margin: 0; padding: 0; background-color: #f4f6f9; font-family: Arial, sans-serif; }
    .wrapper { max-width: 600px; margin: 40px auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
    .header { background-color: #1d4ed8; padding: 28px 40px; text-align: center; }
    .header .tag { display: inline-block; background: rgba(255,255,255,.18); color: #ffffff; font-size: 12px; padding: 4px 10px; border-radius: 999px; margin-bottom: 10px; }
    .header h1 { color: #ffffff; margin: 0; font-size: 22px; }
    .header .sub { color: #ffffff; opacity: .85; font-size: 13px; margin-top: 6px; }
    .body { padding: 36px 40px; }
    .message { color: #444444; font-size: 15px; line-height: 1.6; margin: 0 0 20px; white-space: pre-line; }
    .images img { display: block; width: 100%; max-width: 520px; height: auto; border-radius: 6px; margin: 0 0 12px; }
    .attachments { font-size: 13px; color: #555555; border-top: 1px solid #eee; padding-top: 16px; }
    .attachments ul { margin: 6px 0 0; padding-left: 18px; }
    .footer { background-color: #f4f6f9; padding: 20px 40px; text-align: center; font-size: 12px; color: #aaaaaa; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <span class="tag">{{categoryLabel}}</span>
      <h1>{{title}}</h1>
      <div class="sub">Para {{complexName}}</div>
    </div>
    <div class="body">
      <p class="message">{{body}}</p>
      <div class="images">
        {{#each imageUrls}}
          <img src="{{this}}" alt="Imagen del comunicado" />
        {{/each}}
      </div>
      {{#if hasAttachments}}
        <div class="attachments">
          Archivos adjuntos:
          <ul>
            {{#each attachmentNames}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        </div>
      {{/if}}
    </div>
    <div class="footer">
      Comunicado del equipo EntryLink.
      &copy; {{year}} EntryLink
    </div>
  </div>
</body>
</html>
