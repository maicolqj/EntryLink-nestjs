<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}}</title>
  <style>
    body { margin: 0; padding: 0; background-color: #f4f6f9; font-family: Arial, sans-serif; }
    .wrapper { max-width: 600px; margin: 40px auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
    .header { padding: 28px 40px; text-align: center; }
    .header h1 { color: #ffffff; margin: 0; font-size: 22px; }
    .header .sub { color: #ffffff; opacity: .85; font-size: 13px; margin-top: 6px; }
    .body { padding: 36px 40px; }
    .body p { color: #444444; font-size: 15px; line-height: 1.6; margin: 0 0 16px; }
    .btn-wrap { text-align: center; margin: 28px 0; }
    .btn { display: inline-block; background-color: #1d4ed8; color: #ffffff !important; text-decoration: none; padding: 14px 36px; border-radius: 6px; font-size: 15px; font-weight: bold; }
    .note { font-size: 13px; color: #666666; border-top: 1px solid #eee; padding-top: 16px; }
    .footer { background-color: #f4f6f9; padding: 20px 40px; text-align: center; font-size: 12px; color: #aaaaaa; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header" style="background-color: {{headerColor}};">
      <h1>{{title}}</h1>
      <div class="sub">{{complexName}}</div>
    </div>
    <div class="body">
      <p>{{message}}</p>
      <div class="btn-wrap">
        <a href="{{ctaUrl}}" class="btn">Ver mi suscripción</a>
      </div>
      <p class="note">{{note}}</p>
    </div>
    <div class="footer">
      Este es un mensaje automático. No respondas a este correo.
      &copy; {{year}} EntryLink
    </div>
  </div>
</body>
</html>
