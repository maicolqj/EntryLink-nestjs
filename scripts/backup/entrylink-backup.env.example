# /root/.entrylink-backup.env — permisos 600, dueño root. NO se versiona.
# Llenar en el VPS con un editor (nano). Nunca pegar estos valores en un chat.

# Contenedor de Postgres: docker ps --format '{{.Names}}  {{.Image}}' | grep -i postgis
PG_CONTAINER=

# Cloudflare R2 — token PROPIO del respaldo (Object Read & Write, solo el bucket de respaldos)
R2_ACCOUNT_ID=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=entrylink-backups

# Monitores (opcionales, recomendados). Healthchecks.io: un chequeo por tarea.
#   Diario:  periodo 1 día, gracia 2 h.   Semanal: periodo 7 días, gracia 6 h.
HEALTHCHECK_URL=
HEALTHCHECK_VERIFY_URL=

# Retención (cantidad de respaldos que se conservan por nivel)
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=6
