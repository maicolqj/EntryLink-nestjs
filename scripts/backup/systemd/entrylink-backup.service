[Unit]
Description=EntryLink: respaldo diario de Postgres a R2
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=/root/.entrylink-backup.env
ExecStart=/opt/entrylink-backup/backup-db.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=1h
